{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oasis",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",

  // Serve the existing Vite static build. The Worker runs first ONLY for /api/*;
  // every other path is served directly from ./dist (the unchanged frontend).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // D1 database for reviews (already created + schema applied).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oasis-reviews",
      "database_id": "891e02b4-b434-4e37-a2b6-6ede979941a3"
    }
  ]

  // NOTE: No send_email binding. Cloudflare Email Sending requires Workers Paid
  // and is intentionally NOT used. The contact form stays on EmailJS (client-side).
}
