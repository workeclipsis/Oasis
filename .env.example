# ═══════════════════════════════════════════════════════════════
# OASIS — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
#
# Variables prefixed with VITE_ are exposed to the browser bundle.
# Never put secrets (API keys, auth tokens) in VITE_ variables.
# ═══════════════════════════════════════════════════════════════

# EmailJS — contact form (public key is intentionally client-side per EmailJS architecture)
# These are already hardcoded in src/components/FinalCTA.tsx for convenience.
# If you rotate them, update that file too.
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx

# Public site URL — used in sitemap, OG tags, canonical URLs
VITE_SITE_URL=https://oasis.studio

# ─── Supabase (reviews) ───────────────────────────────────────
# Both are safe to expose client-side. The anon key is protected by
# Row-Level Security. NEVER put the service_role key here.
# Get these from: Supabase → Project Settings → API
# If left blank, the review system falls back to per-browser localStorage.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key
